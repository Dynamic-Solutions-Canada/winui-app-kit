<Project>
  <!--
    Versions of the packages the Windows apps share (PLAT-5, D-096), for central package management.
    An app imports this from its root Directory.Packages.props and adds its own packages there; see
    "Using it" in the README. Do not override these versions in an app: an app never moves ahead of
    the kit, and a move happens here, as its own change.

    Microsoft.WindowsAppSDK stays on the 1.8 line while every consuming app ships with
    Microsoft.WindowsAppRuntime.1.8; moving off it means updating each app's manifest dependency.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageVersion Include="NLog" Version="6.2.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!--
      Windows data protection for projects that compile in WinUIAppKit.Settings.ProtectedStore without
      the Windows Desktop framework: portable test harnesses and helper processes. The kit and the apps
      get it from that framework instead (a direct reference there is error NU1510). Held on the .NET 10
      line with the rest of the family (11.x belongs to the next major).
    -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>
</Project>

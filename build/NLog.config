<?xml version="1.0" encoding="utf-8" ?>
<!--
  The shared NLog config for every Windows app (LOG-1, LOG-2). Apps link it through WinUIAppKit.targets
  and never keep or edit a copy.

  One file per launch: %AppData%\<data folder>\logs.<start time>.txt. The app names its data folder
  with WinUIAppKit.Logging.AppLogging.UseDataFolder before it logs anything; until then the process
  name stands in. maxArchiveFiles keeps the current file plus three older ones: NLog 6.2.2 deletes the
  older per-launch files in that folder when the new file is created (tested; other folders are untouched).
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets async="true">
    <target name="logger" xsi:type="File"
            fileName="${specialfolder:folder=ApplicationData}/${gdc:item=WinUIAppKit.DataFolderName:whenEmpty=${processname}}/logs.${processinfo:StartTime:format=yyyy-MM-dd HH-mm-ss:cached=true}.txt"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message:withexception=true}"
            maxArchiveFiles="3"/>
    <target name="debugger"
            xsi:type="Debugger"
            layout="${level:uppercase=true}|${logger}|${message:withexception=true}"/>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="logger"/>
    <logger name="*" minlevel="Trace" writeTo="debugger"/>
  </rules>
</nlog>

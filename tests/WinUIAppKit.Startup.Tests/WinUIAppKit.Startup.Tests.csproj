<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Portable harness for the start-with-Windows Run entry decision (TEST-2). It links the one production
    file that holds that logic, so it runs on Linux.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../WinUIAppKit/Startup/RunEntry.cs" Link="Linked/RunEntry.cs" />
  </ItemGroup>
</Project>

#!/usr/bin/env bash
# Run every test under the repo's tests/ folder (TEST-2, TEST-5): found by walking the folder, never a
# hand-kept list. Each .NET harness is a console project run with `dotnet run`, and each PowerShell test is
# a *.Tests.ps1 script run with pwsh; both exit non-zero on a failure. They run through the kit's
# scripts/dotnet and scripts/pwsh, so the same command works on Linux and in CI.
#
# The repo is the folder this runs in (npm sets it to the package root), never this script's own path:
# apps call the kit's copy, for example "test": "external/winui-app-kit/scripts/run-tests". Only the
# repo's own tests/ folder is searched, so a submodule's tests never run as the app's.
#
# Finding no harness at all fails, because a test command that ran nothing must not look like a pass.
# A repo that has none yet passes --allow-none, in its own npm script, until it adds one.
set -euo pipefail

kit_scripts="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(pwd)"

allow_none=false
for argument in "$@"; do
    case "$argument" in
        --allow-none) allow_none=true ;;
        *) printf 'run-tests: unknown argument %s (only --allow-none is accepted)\n' "$argument" >&2; exit 2 ;;
    esac
done

# Build output folders can hold copied project files; skip them.
mapfile -t projects < <(
    find "$repo_root/tests" -name '*.csproj' -not -path '*/bin/*' -not -path '*/obj/*' 2>/dev/null | sort
)

mapfile -t scripts < <(
    find "$repo_root/tests" -name '*.Tests.ps1' -not -path '*/bin/*' -not -path '*/obj/*' 2>/dev/null | sort
)

if [[ ${#projects[@]} -eq 0 && ${#scripts[@]} -eq 0 ]]; then
    if [[ "$allow_none" == true ]]; then
        printf 'run-tests: no tests under %s/tests, and --allow-none says that is expected.\n' "$repo_root"
        exit 0
    fi
    printf 'run-tests: found no tests under %s/tests. Run this from the repo root (npm does), or pass --allow-none if the repo has none yet.\n' "$repo_root" >&2
    exit 1
fi

# Paths relative to the repo root, which is also the working directory inside the SDK container.
for project in "${projects[@]}"; do
    relative="${project#"$repo_root"/}"
    printf 'run-tests: %s\n' "$relative"
    "$kit_scripts/dotnet" run --project "$relative"
done

for script in "${scripts[@]}"; do
    relative="${script#"$repo_root"/}"
    printf 'run-tests: %s\n' "$relative"
    "$kit_scripts/pwsh" -NoProfile -File "$relative"
done

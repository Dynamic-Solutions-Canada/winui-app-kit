#!/usr/bin/env bash
# Run the .NET SDK that global.json pins, for the portable checks (format, tests).
#
# Uses `dotnet` from PATH when there is one (CI installs it from global.json). Otherwise runs the
# matching SDK container image, so a Linux machine needs Docker but no host .NET install.
# The library targets Windows, so EnableWindowsTargeting lets the SDK restore and load it on Linux;
# this is enough for `dotnet format` and portable test projects, not for a Windows compile.
#
# The repo is the folder this runs in (npm sets it to the package root), never this script's own path:
# apps call the kit's copy, external/winui-app-kit/scripts/dotnet, and it must use the app's global.json.
#
# Environment overrides:
#   KIT_SDK_COMMAND    the SDK tool to run (default dotnet; scripts/pwsh sets pwsh, which the SDK image ships)
#   KIT_DOTNET_MEMORY  hard memory cap for the container (default 3g, no swap)
#   NUGET_PACKAGES     package cache shared with the container (default ~/.nuget/packages)
set -euo pipefail

repo_root="$(pwd)"
tool="${KIT_SDK_COMMAND:-dotnet}"
export EnableWindowsTargeting=true
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1

# Host SDK first: CI and machines that already have one need no container.
if command -v "$tool" >/dev/null 2>&1; then
    exec "$tool" "$@"
fi

if ! command -v docker >/dev/null 2>&1; then
    printf 'scripts/dotnet: needs either %s on PATH or Docker for the SDK container; found neither.\n' "$tool" >&2
    exit 1
fi

# The image tag is the exact SDK version global.json pins, so the container matches CI.
if [[ ! -f "$repo_root/global.json" ]]; then
    printf 'scripts/dotnet: run this from a repo root with a global.json (npm does this for package scripts); %s has none.\n' "$repo_root" >&2
    exit 1
fi
sdk_version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$repo_root/global.json" | head -1)"
if [[ -z "$sdk_version" ]]; then
    printf 'scripts/dotnet: could not read the SDK version from %s/global.json.\n' "$repo_root" >&2
    exit 1
fi

# A shared package cache keeps restores fast across runs; created first so it is owned by the caller.
packages="${NUGET_PACKAGES:-$HOME/.nuget/packages}"
mkdir -p "$packages"
memory="${KIT_DOTNET_MEMORY:-3g}"

exec docker run --rm \
    --memory "$memory" --memory-swap "$memory" \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -e EnableWindowsTargeting \
    -e DOTNET_CLI_TELEMETRY_OPTOUT \
    -e DOTNET_NOLOGO \
    -e NUGET_PACKAGES=/nuget \
    -v "$packages:/nuget" \
    -v "$repo_root:/src" \
    -w /src \
    "mcr.microsoft.com/dotnet/sdk:$sdk_version" \
    "$tool" "$@"

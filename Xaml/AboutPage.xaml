<!--
  The shared About page (UI-5, BRAND-8): identity, updates, links and diagnostics cards, in that order,
  then the app's own cards. The app navigates here with an AboutInfo; labels come from the kit's
  catalog (kit.about.*); apps never define kit. keys (LOC-7).
-->
<Page
    x:Class="WinUIAppKit.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <ScrollViewer>
        <StackPanel x:Name="Cards" Style="{StaticResource PageContentStyle}">
            <TextBlock l10n:Localize.Text="kit.nav.about" Style="{StaticResource PageTitleStyle}" />

            <!-- Identity -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AppIcon" Width="64" Height="64" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="ProductNameText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Updates -->
            <Border x:Name="UpdatesCard" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock l10n:Localize.Text="kit.about.updates" />
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <HyperlinkButton x:Name="ReleaseLink" l10n:Localize.Content="kit.about.view-release"
                                         Padding="0" Visibility="Collapsed" Click="ReleaseLink_Click" />
                    </StackPanel>
                    <Button x:Name="CheckButton" Grid.Column="1" VerticalAlignment="Center" Click="CheckButton_Click">
                        <StackPanel Style="{StaticResource IconLabelStyle}">
                            <FontIcon Glyph="&#xE895;" Style="{StaticResource ButtonGlyphStyle}" />
                            <TextBlock l10n:Localize.Text="kit.about.check-for-updates" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Links -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="2">
                    <TextBlock l10n:Localize.Text="kit.about.links" Margin="0,0,0,4" />
                    <HyperlinkButton x:Name="SourceLink" l10n:Localize.Content="kit.about.source-code" Padding="0" />
                    <HyperlinkButton x:Name="PrivacyLink" l10n:Localize.Content="kit.about.privacy-policy" Padding="0" />
                    <HyperlinkButton x:Name="SupportLink" l10n:Localize.Content="kit.about.support" Padding="0" />
                    <HyperlinkButton x:Name="LicenseLink" l10n:Localize.Content="kit.about.license" Padding="0" />
                    <HyperlinkButton x:Name="NoticesLink" l10n:Localize.Content="kit.about.third-party-notices" Padding="0" />
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock l10n:Localize.Text="kit.about.diagnostics" />
                        <TextBlock x:Name="LogsPath" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Click="OpenLogs_Click">
                        <StackPanel Style="{StaticResource IconLabelStyle}">
                            <FontIcon Glyph="&#xE838;" Style="{StaticResource ButtonGlyphStyle}" />
                            <TextBlock l10n:Localize.Text="kit.about.open-logs-folder" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

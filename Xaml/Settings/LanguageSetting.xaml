<!-- The "Language" row (UI-4, LOC-4): Use system setting, then every supported language under its own name. -->
<UserControl
    x:Class="WinUIAppKit.Controls.LanguageSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <ComboBox x:Name="Choices" l10n:Localize.Header="kit.settings.language" MinWidth="220"
              SelectionChanged="Choices_SelectionChanged" />
</UserControl>

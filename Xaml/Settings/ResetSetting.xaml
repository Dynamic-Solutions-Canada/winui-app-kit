<!--
  The "Reset settings" row (CONF-4): a description and a button that asks first (Cancel is the default),
  then runs the app's own reset. What a reset keeps, and how, is the app's; the row only asks and reports.
-->
<UserControl
    x:Class="WinUIAppKit.Controls.ResetSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <StackPanel Spacing="8">
        <TextBlock l10n:Localize.Text="kit.settings.reset-header" />
        <TextBlock l10n:Localize.Text="kit.settings.reset-desc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Name="ResetButton" Click="ResetButton_Click" HorizontalAlignment="Left">
            <StackPanel Style="{StaticResource IconLabelStyle}">
                <FontIcon Glyph="&#xE777;" Style="{StaticResource ButtonGlyphStyle}" />
                <TextBlock l10n:Localize.Text="kit.settings.reset-button" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>

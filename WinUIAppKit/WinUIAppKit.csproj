<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <!--
      Minimum supported Windows: 10 22H2 (build 19045), so every app can use the kit (PLAT-6, D-018).
      The platform-compatibility analyzer (CA1416) checks annotated calls against this floor. Windows
      SDK annotations stop at build 19041 and Win32 calls have none, so Windows 11-only calls go in
      helpers marked [SupportedOSPlatform("windows10.0.22000")] behind a runtime build check.
    -->
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>$(SupportedOSPlatformVersion)</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>WinUIAppKit</RootNamespace>
    <AssemblyName>WinUIAppKit</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public members must be documented (CS1591 is a warning); only Interop/NativeMethods.cs opts out. -->
  </PropertyGroup>

  <!-- Versions come from build/WinUIAppKit.Packages.props (central package management). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="NLog" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
</Project>

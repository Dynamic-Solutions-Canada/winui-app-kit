<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>WinUIAppKit</RootNamespace>
    <AssemblyName>WinUIAppKit</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public members must be documented (CS1591 is a warning); only Interop/NativeMethods.cs opts out. -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to the 1.8 line on purpose: every consuming app ships against
      Microsoft.WindowsAppRuntime.1.8. An app may reference a newer SDK itself; NuGet then resolves
      the higher version for both.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="NLog" Version="6.2.2" />
  </ItemGroup>
</Project>

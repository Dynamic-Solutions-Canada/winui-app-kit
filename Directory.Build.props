<Project>
  <!-- The kit uses the same shared build properties it gives the apps. -->
  <Import Project="$(MSBuildThisFileDirectory)build/WinUIAppKit.props" />

  <!--
    The kit's one version source (REL-1): SemVer, matching the vX.Y.Z tag apps pin (KIT-6).
    Bumped only by the release procedure, in the commit that adds release-notes/<version>.md.
  -->
  <PropertyGroup>
    <Version>1.19.0</Version>
  </PropertyGroup>
</Project>
